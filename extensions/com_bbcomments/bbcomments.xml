<extension type="component" version="4.0.0" method="upgrade">
	<name>COM_BBCOMMENTS</name>
	<creationDate>2026-11-27</creationDate>
	<author>BlackBrix</author>
	<authorEmail></authorEmail>
	<authorUrl></authorUrl>
	<copyright>Copyright (c)2020-2025 Nicholas K. Dionysopoulos / Akeeba Ltd; modifications (c)2026 BlackBrix</copyright>
	<license>GNU/GPL v3 or any later version</license>
	<version>1.0.3</version>
	<description>COM_BBCOMMENTS_XML_DESCRIPTION</description>
	<namespace path="src">BlackBrix\Component\Bbcomments</namespace>

	<!-- Public front end files -->
	<files folder="frontend">
		<folder>forms</folder>
		<folder>src</folder>
		<folder>tmpl</folder>

		<filename>.htaccess</filename>
		<filename>web.config</filename>
	</files>

	<!-- Front end translation files -->
	<languages folder="frontend/language">
		<language tag="en-GB">en-GB/com_bbcomments.ini</language>
		<language tag="de-DE">de-DE/com_bbcomments.ini</language>
	</languages>

	<!-- Administrator back-end section -->
	<administration>
		<!-- Administration menu -->
		<menu>COM_BBCOMMENTS</menu>

		<!-- Back-end files -->
		<files folder="backend">
			<folder>forms</folder>
			<folder>layout</folder>
			<folder>services</folder>
			<folder>sql</folder>
			<folder>src</folder>
			<folder>tmpl</folder>

			<filename>access.xml</filename>
			<filename>config.xml</filename>

			<filename>.htaccess</filename>
			<filename>web.config</filename>
		</files>

		<!-- Back-end translation files -->
		<languages folder="backend/language">
			<language tag="en-GB">en-GB/com_bbcomments.ini</language>
			<language tag="en-GB">en-GB/com_bbcomments.sys.ini</language>

			<language tag="de-DE">de-DE/com_bbcomments.ini</language>
			<language tag="de-DE">de-DE/com_bbcomments.sys.ini</language>




		</languages>
	</administration>

	<!-- Media files -->
	<media destination="com_bbcomments" folder="media">
		<folder>css</folder>
		
		<folder>images</folder>
		<folder>js</folder>
		<filename>index.html</filename>
		<filename>joomla.asset.json</filename>
	</media>

	<!-- Database tables installation, uninstallation and update -->
	<install>
		<sql>
			<file driver="mysql" charset="utf8">sql/install.mysql.utf8.sql</file>
		</sql>
	</install>

	<uninstall>
		<sql>
			<file driver="mysql" charset="utf8">sql/uninstall.mysql.utf8.sql</file>
		</sql>
	</uninstall>

</extension>
