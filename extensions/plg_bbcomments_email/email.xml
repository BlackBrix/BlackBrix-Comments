<extension version="3.9.0" type="plugin" group="bbcomments" method="upgrade">
    <name>PLG_BBCOMMENTS_EMAIL</name>
    <description>PLG_BBCOMMENTS_EMAIL_XML_DESC</description>
    <version>1.0.0</version>
    <creationDate>2026-11-23</creationDate>
    <author>BlackBrix</author>
    <authorEmail></authorEmail>
    <authorUrl></authorUrl>
    <copyright>Copyright (c)2020-2025 Nicholas K. Dionysopoulos / Akeeba Ltd; modifications (c)2026 BlackBrix</copyright>
    <license>GNU/GPL v3 or any later version</license>
    <namespace path="src">BlackBrix\Plugin\Bbcomments\Email</namespace>

    <files>
        <folder plugin="email">src</folder>
        <folder>services</folder>

        <filename>.htaccess</filename>
        <filename>web.config</filename>
    </files>
    <languages folder="language">
        <language tag="de-DE">de-DE/plg_bbcomments_email.ini</language>
        <language tag="de-DE">de-DE/plg_bbcomments_email.sys.ini</language>
        <language tag="en-GB">en-GB/plg_bbcomments_email.ini</language>
        <language tag="en-GB">en-GB/plg_bbcomments_email.sys.ini</language>
    </languages>

    <config addfieldpath="/administrator/components/com_bbcomments/fields">
        <fields name="params">
            <fieldset
                    name="basic"
                    label="PLG_BBCOMMENTS_EMAIL_FIELDSET_BASIC_LABEL"
                    description="PLG_BBCOMMENTS_EMAIL_FIELDSET_BASIC_DESC"
            >
                <field
                        name="managers_notify"
                        type="radio"
                        layout="joomla.form.field.radio.switcher"
                        label="PLG_BBCOMMENTS_EMAIL_MANAGERS_TOPLEVEL_NOTIFY_LABEL"
                        description="PLG_BBCOMMENTS_EMAIL_MANAGERS_TOPLEVEL_NOTIFY_DESC"
                        default="0"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

                <field
                        name="managers_notify_spam"
                        type="radio"
                        layout="joomla.form.field.radio.switcher"
                        label="PLG_BBCOMMENTS_EMAIL_MANAGERS_TOPLEVEL_NOTIFY_SPAM_LABEL"
                        description="PLG_BBCOMMENTS_EMAIL_MANAGERS_TOPLEVEL_NOTIFY_SPAM_DESC"
                        default="0"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

            </fieldset>
        </fields>
    </config>
</extension>