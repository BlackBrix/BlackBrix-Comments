<extension version="3.9.0" type="plugin" group="actionlog" method="upgrade">
    <name>PLG_ACTIONLOG_BBCOMMENTS</name>
    <description>PLG_ACTIONLOG_BBCOMMENTS_XML_DESC</description>
    <version>1.0.0</version>
    <creationDate>2026-11-23</creationDate>
    <author>BlackBrix</author>
    <authorEmail></authorEmail>
    <authorUrl></authorUrl>
    <copyright>Copyright (c)2020-2025 Nicholas K. Dionysopoulos / Akeeba Ltd; modifications (c)2026 BlackBrix</copyright>
    <license>GNU/GPL v3 or any later version</license>
    <namespace path="src">BlackBrix\Plugin\Actionlog\Bbcomments</namespace>

    <files>
        <folder plugin="bbcomments">src</folder>
        <folder>services</folder>

        <filename>.htaccess</filename>
        <filename>web.config</filename>
    </files>
    <languages folder="language">
        <language tag="de-DE">de-DE/plg_actionlog_bbcomments.ini</language>
        <language tag="de-DE">de-DE/plg_actionlog_bbcomments.sys.ini</language>
        <language tag="en-GB">en-GB/plg_actionlog_bbcomments.ini</language>
        <language tag="en-GB">en-GB/plg_actionlog_bbcomments.sys.ini</language>
    </languages>

    <config>
        <fields name="params">
            <fieldset name="basic"
                      addfieldpath="/administrator/components/com_bbcomments/fields"
            >

                <field
                        name="log_comments"
                        type="radio"
                        layout="joomla.form.field.radio.switcher"
                        label="PLG_ACTIONLOG_BBCOMMENTS_LOG_COMMENTS_LABEL"
                        description="PLG_ACTIONLOG_BBCOMMENTS_LOG_COMMENTS_DESC"
                        default="0"
                >
                    <option value="0">JNO</option>
                    <option value="1">JYES</option>
                </field>

            </fieldset>
        </fields>
    </config>

</extension>
